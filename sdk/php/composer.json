{
    "name": "idbseq/idbseq",
    "description": "PHP client for the idbseq ID sequence server",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "id",
        "sequence",
        "idbseq",
        "psr-18"
    ],
    "homepage": "https://github.com/aevantec/idbseq",
    "support": {
        "issues": "https://github.com/aevantec/idbseq/issues",
        "source": "https://github.com/aevantec/idbseq/tree/main/sdk/php",
        "docs": "https://github.com/aevantec/idbseq/blob/main/sdk/php/README.md"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "php-http/discovery": "^1.19",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "suggest": {
        "php-http/discovery": "Finds an installed PSR-18 client and PSR-17 factories when none are passed to the constructor"
    },
    "autoload": {
        "psr-4": {
            "IdbSeq\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IdbSeq\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit --no-coverage",
        "test:coverage": [
            "@php vendor/bin/phpunit --testsuite unit --coverage-clover build/clover.xml --coverage-text",
            "@php bin/check-coverage.php build/clover.xml 80"
        ],
        "test:e2e": "phpunit --testsuite e2e --no-coverage",
        "phpstan": "phpstan analyse --no-progress --memory-limit=512M"
    }
}
